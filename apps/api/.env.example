# Copy to .env and edit. This file is committed; .env is not.

PORT=3000
HOST=0.0.0.0

MONGO_URL=mongodb://localhost:27017
MONGO_DB=mixer

JWT_SECRET=replace-me-with-a-long-random-string

ACCESS_TTL_SECONDS=900
REFRESH_TTL_SECONDS=2592000
BCRYPT_COST=12

# Web Application OAuth client ID from Google Cloud Console.
GOOGLE_CLIENT_ID=
# That same web client's secret. Only the browser flow needs it — /auth/google/code has
# the server exchange the authorization code — but without it that route answers 503
# "google sign-in not configured" even though GOOGLE_CLIENT_ID is set.
GOOGLE_CLIENT_SECRET=
